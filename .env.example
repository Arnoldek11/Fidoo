# Copy to .env.local (Supabase keys) and .env (DB connection strings) as needed.
# Never commit real values — this file only documents what's required.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres via Supabase (Project Settings -> Database -> Connection string)
# DATABASE_URL: transaction pooler (port 6543) — used at runtime
# DIRECT_URL: direct connection (port 5432) — used only by Prisma Migrate
DATABASE_URL=
DIRECT_URL=

# Twilio (console.twilio.com dashboard)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Inngest — only needed once deployed to Inngest Cloud (not for local dev,
# which uses `npx inngest-cli dev` against http://localhost:3000/api/inngest)
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# Sentry (sentry.io project settings -> Client Keys (DSN))
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed for source map upload at build time, not for error reporting itself
# SENTRY_ORG=
# SENTRY_PROJECT=

# Stripe (dashboard.stripe.com/test/apikeys) — test mode keys while piloting
STRIPE_SECRET_KEY=
# Price ID for the single "standard" paid plan (dashboard.stripe.com/test/products)
STRIPE_STANDARD_PRICE_ID=
# From `stripe listen --forward-to localhost:3100/api/webhooks/stripe` locally,
# or the endpoint's signing secret from the Stripe Dashboard once deployed
STRIPE_WEBHOOK_SECRET=
