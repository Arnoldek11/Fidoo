// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Establishment {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  city      String
  plan      String   @default("pilote")
  createdAt DateTime @default(now()) @map("created_at")

  users     EstablishmentUser[]
  customers Customer[]
  events    Event[]

  @@map("establishments")
}

// id is NOT auto-generated: it must equal the Supabase Auth user's id (auth.uid()),
// set explicitly when the row is created. See migration.sql for the FK into auth.users
// and the RLS policies that rely on id = auth.uid().
model EstablishmentUser {
  id              String   @id @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  email           String
  role            String   @default("owner")
  createdAt       DateTime @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, email])
  @@map("establishment_users")
}

model Customer {
  id                String    @id @default(uuid()) @db.Uuid
  establishmentId   String    @map("establishment_id") @db.Uuid
  phone             String
  name              String?
  // Nullable on purpose: a customer can be tracked (visits, points) without
  // having consented to marketing communications. Phase 5's sender must
  // check this is non-null before contacting anyone — see lib/customers/consent.ts.
  consentGivenAt    DateTime? @map("consent_given_at")
  consentChannel    String?   @map("consent_channel")
  createdAt         DateTime  @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  events        Event[]

  @@unique([establishmentId, phone])
  @@map("customers")
}

// Immutable append-only journal: INSERT only, never UPDATE/DELETE (enforced
// both by RLS having no UPDATE/DELETE policy and by an explicit REVOKE in
// the migration). Balances and stats are always computed from this table,
// never stored as a field that gets mutated directly.
model Event {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  // One of: visit, points_added, reward_redeemed (validated with Zod at the
  // Server Action boundary, not a DB enum, since later phases add more types).
  type            String
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("events")
}
