// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Establishment {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  city      String
  plan      String   @default("pilote")
  // Mirrors the Stripe subscription's own `status` string directly
  // (trialing/active/past_due/canceled/incomplete/...) rather than
  // reinventing a translation table — Stripe is the source of truth for
  // billing state. Null until the establishment has ever had a subscription.
  billingStatus        String?  @map("billing_status")
  stripeCustomerId     String?  @unique @map("stripe_customer_id")
  stripeSubscriptionId String?  @unique @map("stripe_subscription_id")
  // Used to estimate revenue attributed to win-back campaigns (Phase 5).
  // Nullable: until an owner sets it, attributed returns are still counted,
  // just without a revenue estimate.
  averageBasketCents Int?     @map("average_basket_cents")
  createdAt DateTime @default(now()) @map("created_at")

  users        EstablishmentUser[]
  customers    Customer[]
  events       Event[]
  auditLogs    AuditLog[]
  staffMembers StaffMember[]

  @@map("establishments")
}

// id is NOT auto-generated: it must equal the Supabase Auth user's id (auth.uid()),
// set explicitly when the row is created. See migration.sql for the FK into auth.users
// and the RLS policies that rely on id = auth.uid().
model EstablishmentUser {
  id              String   @id @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  email           String
  role            String   @default("owner")
  createdAt       DateTime @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, email])
  @@map("establishment_users")
}

model Customer {
  id                String    @id @default(uuid()) @db.Uuid
  establishmentId   String    @map("establishment_id") @db.Uuid
  phone             String
  name              String?
  // Nullable on purpose: a customer can be tracked (visits, points) without
  // having consented to marketing communications. Phase 5's sender must
  // check this is non-null before contacting anyone — see lib/customers/consent.ts.
  consentGivenAt    DateTime? @map("consent_given_at")
  consentChannel    String?   @map("consent_channel")
  createdAt         DateTime  @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  events        Event[]

  @@unique([establishmentId, phone])
  @@index([establishmentId])
  @@map("customers")
}

// Immutable append-only journal: INSERT only, never UPDATE/DELETE (enforced
// both by RLS having no UPDATE/DELETE policy and by an explicit REVOKE in
// the migration). Balances and stats are always computed from this table,
// never stored as a field that gets mutated directly.
model Event {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  // Nullable: right-to-erasure deletes the Customer row but keeps their
  // events (SET NULL, not CASCADE) so establishment-wide aggregates don't
  // develop holes just because one customer was forgotten. See
  // lib/customers/erasure.ts.
  customerId      String?  @map("customer_id") @db.Uuid
  // Nullable: only set for staff-validated counter actions (Phase 4 Staff
  // PWA). SET NULL (not CASCADE) so deactivating/removing a staff member
  // never rewrites or drops historical events — the ledger stays append-only
  // and untouched, it just loses the attribution link.
  staffId         String?  @map("staff_id") @db.Uuid
  // One of: visit, points_added, reward_redeemed, points_reversed,
  // campaign_sent, attributed_return (validated with Zod at the Server
  // Action boundary, not a DB enum, since later phases add more types).
  type            String
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staff         StaffMember?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([establishmentId, type, createdAt])
  @@map("events")
}

// Phase 4 (revised): a lightweight per-employee roster for counter-staff
// attribution. Deliberately NOT an EstablishmentUser — that model's id is
// hard-FK'd to auth.users (a real Supabase Auth account per row), and the
// whole point of "PIN-based, not a full Supabase account per employee" is
// to avoid provisioning one. Security boundary is unchanged: the device
// running the Staff PWA still authenticates as a normal EstablishmentUser
// (RLS via asEstablishmentUser), and the PIN only selects/attributes which
// staff member is performing the action — it is not a second auth system.
model StaffMember {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String
  // Salted hash (scrypt), never the raw PIN. See lib/staff/pin.ts.
  pinHash         String   @map("pin_hash")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  events        Event[]

  @@unique([establishmentId, name])
  @@index([establishmentId])
  @@map("staff_members")
}

// Append-only audit trail of sensitive customer-data access (Phase 7 GDPR
// requirement) — who viewed or erased which customer, and when. Same
// immutability pattern as Event: INSERT only.
model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  actorUserId     String   @map("actor_user_id") @db.Uuid
  // One of: viewed_customer, erased_customer
  action          String
  targetType      String   @map("target_type")
  targetId        String   @map("target_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, createdAt])
  @@map("audit_logs")
}
